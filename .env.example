# ตั้งค่าพอร์ตเซิร์ฟเวอร์
PORT=3000

# LINE Developers Credentials (สำหรับเชื่อมต่อจริง)
# ได้จาก LINE Developers Console > Messaging API Channel > Channel access token
LINE_CHANNEL_ACCESS_TOKEN=

# ได้จาก LINE Developers Console > Basic settings > Channel secret
LINE_CHANNEL_SECRET=

# ได้จาก LINE Developers Console > LIFF > LIFF ID (เช่น 1234567890-abcdefgh)
LINE_LIFF_ID=
